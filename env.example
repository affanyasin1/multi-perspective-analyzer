# LLM provider (OpenAI-compatible). Leave LLM_API_KEY empty to use the mock provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Server
PORT=4000
REFRESH_INTERVAL_MIN=60

# Crawl archive — one JSON line per unique article, appended every crawl.
ARCHIVE_FILE=data/archive.jsonl
